# Copy this file to .env and fill in your API keys.
# dataset.py, eval.py use: GENERATION_MODEL and JUDGE_MODEL
# compressors.py (SummarizationCompressor) uses: SUMMARIZATION_MODEL

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic (optional — uncomment if using Claude via litellm)
# ANTHROPIC_API_KEY=sk-ant-...

# Model identifiers passed to litellm.completion()
GENERATION_MODEL=gpt-4o
JUDGE_MODEL=gpt-4o
SUMMARIZATION_MODEL=gpt-4o-mini

# Generation settings
DATASET_PATH=data/conversations.jsonl
RESULTS_PATH=results/eval_results.jsonl
PLOTS_DIR=plots
